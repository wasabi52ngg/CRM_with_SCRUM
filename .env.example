POSTGRES_DB=itcrm
POSTGRES_USER=itcrm
POSTGRES_PASSWORD=itcrm
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=change-me

# Локальные тесты: python manage.py test (SQLite в памяти, без CREATEDB в PostgreSQL).
# Принудительно PostgreSQL в тестах: USE_PG_FOR_TESTS=1 python manage.py test
# Весь проект на SQLite: USE_SQLITE=1 python manage.py runserver

# Оператор персональных данных (152-ФЗ) — для страницы /privacy/
SITE_OPERATOR_NAME=IT CRM
SITE_OPERATOR_EMAIL=privacy@example.com
SITE_OPERATOR_ADDRESS=
